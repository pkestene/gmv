#cmakedefine GMV_HAS_GIT_INFO

#define GMV_VERSION "@GMV_VERSION@"

// clang-format off
#define GMV_GIT_TAG "@GMV_GIT_TAG@"
#define GMV_GIT_HASH "@GMV_GIT_HASH@"
#define GMV_GIT_HEAD "@GMV_GIT_HEAD@"
#define GMV_GIT_HAS_LOCAL_CHANGES "@GMV_GIT_HAS_LOCAL_CHANGES@"
#define GMV_GIT_IS_CLEAN @GMV_GIT_IS_CLEAN@
#define GMV_GIT_REMOTE_URL "@GMV_GIT_REMOTE_URL@"
#define GMV_GIT_BRANCH "@GMV_GIT_BRANCH@"

#define GMV_COMPILE_DATE "@GMV_COMPILE_DATE@"
#define GMV_COMPILE_TIME "@GMV_COMPILE_TIME@"
// clang-format on

#endif // GMV_VERSION_H_
